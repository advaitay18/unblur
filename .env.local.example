# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it's already covered by the .gitignore below.

# Gemini API key (Module 1 — /api/analyze)
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-key"

# Supabase Postgres connection strings (Module 2 — Prisma)
# DATABASE_URL: pooled connection (PgBouncer, port 6543) for the running app
# DIRECT_URL: direct connection (port 5432) for migrations only
DATABASE_URL="postgresql://postgres:[password]@[project-ref].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@[project-ref].pooler.supabase.com:5432/postgres"

# Supabase project keys, if you use the Supabase client anywhere beyond Prisma
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# PostHog (Module 4 — analytics)
NEXT_PUBLIC_POSTHOG_KEY="phc_your_project_key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
POSTHOG_SERVER_KEY="phc_your_server_key"
