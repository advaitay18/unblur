# Copy this file to .env.local and fill in real values.
# NEVER commit .env or .env.local — it's covered by .gitignore.

# Gemini API key (Module 1 — /api/quiz & /api/analyze)
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-key"

# Supabase / PostgreSQL connection strings (Module 2 — Prisma)
# DATABASE_URL: pooled connection (PgBouncer/Supavisor, port 6543) for the running app
# DIRECT_URL: direct connection (port 5432) for migrations & npx prisma db push
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Supabase project keys, if you use the Supabase client anywhere beyond Prisma
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# PostHog (Module 4 — analytics)
NEXT_PUBLIC_POSTHOG_KEY="phc_your_project_key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
POSTHOG_SERVER_KEY="phc_your_server_key"

# Google Sheets Webhook for Feedback
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/your-deployment-id/exec"
