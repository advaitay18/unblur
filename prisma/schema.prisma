// prisma/schema.prisma
// Module 2: Database Schema & State Persistence
// datasource assumes Supabase Postgres (connection pooling via PgBouncer on DATABASE_URL,
// direct connection on DIRECT_URL for migrations)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Optional identity — Unblur is guest-first. A row is created lazily only if
// the user supplies an email (e.g. to receive their PDF report).
model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String?
  createdAt DateTime @default(now())

  sessions QuizSession[]

  @@map("users")
}

// One row per quiz attempt. This is what fixes "session loss on refresh":
// the client persists sessionId in localStorage and calls
// saveProgress() after every answered question, so a refresh just
// rehydrates from this row instead of losing state.
model QuizSession {
  id            String    @id @default(cuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  status        SessionStatus @default(IN_PROGRESS)
  currentIndex  Int       @default(0) // 0-24, last answered question index
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  lastActiveAt  DateTime  @updatedAt

  responses QuizResponse[]
  report    GeneratedReport?

  @@index([userId])
  @@map("quiz_sessions")
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// Raw answer choices — one row per answered question, upserted as the user
// progresses so a refresh mid-quiz loses nothing.
model QuizResponse {
  id          String      @id @default(cuid())
  sessionId   String
  session     QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId  String
  optionId    String
  timeSpentMs Int? // for the analytics drop-off/engagement calc in Module 4
  answeredAt  DateTime    @default(now())

  @@unique([sessionId, questionId]) // upsert target: re-answering overwrites, not duplicates
  @@index([sessionId])
  @@map("quiz_responses")
}

// The full Gemini JSON payload, stored verbatim (jsonb) plus a shareable slug.
model GeneratedReport {
  id        String      @id @default(cuid())
  sessionId String      @unique
  session   QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  slug      String      @unique // used in /report/[slug]
  payload   Json // full typed JSON from Module 1
  pdfUrl    String? // set after first PDF generation, cached for re-download
  createdAt DateTime    @default(now())

  @@index([slug])
  @@map("generated_reports")
}
model Feedback { id String @id @default(cuid()) rating Int comment String? createdAt DateTime @default(now()) } 
 
model Feedback { 
  id        String   @id @default(cuid()) 
  rating    Int 
  comment   String? 
  reportId  String? 
  sessionId String? 
  createdAt DateTime @default(now()) 
}
